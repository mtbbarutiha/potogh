# ===== الزامی =====
# توکن ربات از @BotFather (ربات: @Patoghchatbot)
BOT_TOKEN=your_telegram_bot_token_here

# اتصال به PostgreSQL — کاربر دیتابیس باید "patogh" باشد (migrationها به این نقش GRANT می‌دهند)
DATABASE_URL="postgresql://patogh:PASSWORD@localhost:5432/patogh?schema=public"

# آیدی عددی ادمین‌ها (با کاما جدا کن). آیدی خودت را از @userinfobot بگیر
ADMIN_IDS=123456789

# ===== عضویت اجباری در کانال (اختیاری ولی توصیه‌شده) =====
# یوزرنیم کانال با @ ، یا آیدی عددی چت. اگر خالی باشد عضویت اجباری غیرفعال است
FORCE_JOIN_CHANNEL=@YourChannel
FORCE_JOIN_CHAT_ID=

# ===== پرداخت کارت‌به‌کارت (اختیاری) =====
CARD_NUMBER=
CARD_HOLDER=
CARD_BANK=

# ===== سایر (اختیاری، مقدار پیش‌فرض دارند) =====
# NODE_ENV=production
# LOG_DEBUG=0
# ALLOW_DEMO_PAY=0
# PATOGH_MODE=
# WEB_APP_URL=
# PUBLIC_THUMB_BASE_URL=
# THUMB_DIR=
# THUMB_INDEX_PATH=
# THUMB_STORAGE_ADMIN_ID=
# ALBUM_NAME_FONT=
# INLINE_THUMB_CDN_TTL=
